{
  "rewrites": [
    {
      "source": "/team-showcase",
      "destination": "/team-showcase/index.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics/index.html"
    },
    {
      "source": "/team/:teamId",
      "destination": "/team/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/team-builder",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/showcase",
      "destination": "/team-showcase",
      "permanent": true
    },
    {
      "source": "/meta-analytics",
      "destination": "/analytics",
      "permanent": true
    },
    {
      "source": "/team-showcase/index.html",
      "destination": "/team-showcase",
      "permanent": true
    },
    {
      "source": "/analytics/index.html",
      "destination": "/analytics",
      "permanent": true
    }
  ]
}
